{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs2022-vcpkg",
      "displayName": "Visual Studio 2022 with vcpkg OpenCV",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022-vcpkg",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "ninja-vcpkg",
      "displayName": "Ninja with vcpkg OpenCV",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja-vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_APPLOCAL_DEPS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2022-vcpkg-release",
      "configurePreset": "vs2022-vcpkg",
      "configuration": "Release"
    },
    {
      "name": "ninja-vcpkg-release",
      "configurePreset": "ninja-vcpkg",
      "configuration": "Release"
    }
  ]
}
